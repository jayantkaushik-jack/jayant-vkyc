# Copy this file to .env and fill in a real key. Never commit .env.
#
# Used server-side only — by the Vite dev middleware (vite.config.ts) for
# `npm run dev`, and read the same way by Vercel's own project env vars on
# a deployed build. The key never reaches the browser bundle either way.
ANTHROPIC_API_KEY=

# Round 24 — server-side only, same pattern as ANTHROPIC_API_KEY above. Used
# to mint short-lived single-use tokens (api/stt-token.ts) for ElevenLabs
# Scribe v2 Realtime speech-to-text; the raw key itself never reaches the
# browser bundle.
ELEVENLABS_API_KEY=
